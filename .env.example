# AI provider used by the backend.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-your-gemini-api-key

# Storage provider. `local` is the currently supported default.
STORAGE_PROVIDER=local
DRIVE_FOLDER_NAME=yt-transcriber
DRIVE_INPUT_FOLDER=yt-transcriber-input
# DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_SERVICE_ACCOUNT=base64-encoded-json
# GOOGLE_OAUTH_CREDENTIALS=base64-encoded-json
# GOOGLE_OAUTH_TOKEN=base64-encoded-json

# Transcript provider used by the backend/frontend integration.
TRANSCRIPT_PROVIDER=youtube
# CLOUDFLARE_WORKER_URL=

# Future provider examples (not implemented yet):
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=replace-with-your-openai-api-key
# STORAGE_PROVIDER=mega
# MEGA_USER=
# MEGA_PASSWORD=
